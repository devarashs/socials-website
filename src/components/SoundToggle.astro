---
/**
 * The "SFX on/off" switch for the hover notes, pinned to the top-right corner.
 *
 * Unrequested sound is the thing visitors most resent a website for, so the
 * mute control is always one click away and the choice is remembered. Ships
 * `hidden`; scripts/hoverNotes.ts reveals it only where Web Audio exists.
 *
 * This component also boots the hover notes, because the two are one feature:
 * without the script the button would be a dead control.
 */
---

<button type="button" class="sound-toggle" data-sound-toggle aria-pressed="true" hidden>
  <span class="sound-toggle__lamp" aria-hidden="true"></span>
  <span>SFX <span data-sound-label>On</span></span>
</button>

<script>
  import { enableHoverNotes } from '../scripts/hoverNotes';

  /** `localStorage` itself throws on access when site data is blocked. */
  function getLocalStorage(): Storage | undefined {
    try {
      return window.localStorage;
    } catch {
      return undefined;
    }
  }

  enableHoverNotes({
    root: document,
    createAudioContext: 'AudioContext' in window ? () => new AudioContext() : undefined,
    storage: getLocalStorage(),
  });
</script>

<style>
  .sound-toggle {
    position: fixed;
    top: var(--space-3);
    right: var(--space-3);
    /* Below the scanline overlay (which is click-through), above the page. */
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    /* 44px minimum touch target. */
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-void) 80%, transparent);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .sound-toggle:hover {
    color: var(--color-text);
  }

  /* State is carried by the On/Off text; the lamp only reinforces it. */
  .sound-toggle__lamp {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-text-muted);
    opacity: 0.45;
    transition: opacity var(--motion-fast) var(--ease-out);
  }

  .sound-toggle[aria-pressed='true'] .sound-toggle__lamp {
    background: var(--color-accent);
    opacity: 1;
  }
</style>
